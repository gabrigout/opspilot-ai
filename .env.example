# Copy to .env (never commit .env). Used by docker compose and by the backend when run locally.

# --- General -----------------------------------------------------------------
ENVIRONMENT=development                # development | production (production disables demo users)
SECRET_KEY=dev-secret-change-me        # >= 32 random chars in production:  python -c "import secrets;print(secrets.token_urlsafe(48))"
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:8080,http://localhost:5173   # comma separated; "*" is ignored on purpose

# --- Database ----------------------------------------------------------------
# Local without Docker (default):     sqlite:///./opspilot.db
# Docker Compose / managed Postgres:  postgresql+psycopg://user:password@host:5432/opspilot
DATABASE_URL=sqlite:///./opspilot.db
POSTGRES_PASSWORD=opspilot_local_only  # docker compose only
SEED_DEMO_DATA=true                    # seeds fictitious data when the database is empty

# --- Production admin bootstrap (no demo users are created when ENVIRONMENT=production) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- AI ----------------------------------------------------------------------
AI_PROVIDER=auto                       # auto (Anthropic if a key exists, otherwise demo) | anthropic | demo
ANTHROPIC_API_KEY=                     # leave empty for demo mode
ANTHROPIC_MODEL=claude-sonnet-5-5
AGENT_MAX_ITERATIONS=6
AGENT_TIMEOUT_SECONDS=60
AGENT_RATE_LIMIT_PER_MINUTE=20

# --- Operational rules (optional JSON overrides, see docs/ARCHITECTURE.md) ---
# RULES_OVERRIDES={"risk_remaining_minutes": 12, "courier_wait_minutes": 6}

# --- Frontend (build time) ----------------------------------------------------
# Empty = same origin (dev proxy / nginx). On Vercel set it to the backend URL, e.g. https://opspilot-api.onrender.com
VITE_API_URL=
